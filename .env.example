# ── Same Neon Postgres database as the main TukaPuka app ────────────────────
# This site writes Tenant + User rows directly into the SAME database the
# main app reads from. Copy the exact same values from tukapuka-main/.env.
DATABASE_URL="postgresql://...neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://...neon.tech/neondb?sslmode=require"

# ── Same Clerk application as the main TukaPuka app ─────────────────────────
# Using the SAME Clerk app (same keys) is what makes "same login" work:
# a person who signs up here and signs in on the main app later (or vice
# versa) is recognized as the exact same Clerk user (same clerkId), even
# though the two sites are on different domains.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Where to send people after their academy is ready / if they already belong
# to one. Point this at wherever tukapuka-main is deployed.
NEXT_PUBLIC_MAIN_APP_URL="http://localhost:3000"
